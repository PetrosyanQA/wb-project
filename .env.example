# Պատճենիր որպես .env և լրացրու։ .env-ը ՄԻ ԴԻՐ git-ում և ՄԻ ՈՒՂԱՐԿԻՐ չաթում։

# ── MPSTATS (արտաքին անալիտիկա) ───────────────────────────────────────────
# https://mpstats.io/userpanel → բլոկ «API token»
# Ուշադրություն՝ գաղտնաբառը փոխելիս թոքենը ավտոմատ թարմանում է։
MPSTATS_TOKEN=

# ── WB SELLER API (քո կաբինետը) ───────────────────────────────────────────
# WB Partners → Настройки → Доступ к API → Создать новый токен
#   ✅ «Только на чтение»            (պարտադիր — AI-ը չի կարողանա ոչինչ փոխել)
#   ❌ «Тестовый контур»             (մի՛ նշիր)
#   Կատեգորիաներ՝ Тарифы, Контент, Статистика, Аналитика [, Продвижение]
#   Ժամկետ՝ 180 օր → դիր հիշեցում օրացույցում


# Ոչ պարտադիր
MPSTATS_TIMEOUT=90

# ── WB թոքեններ ──────────────────────────────────────────────────────────────
# Տարբերակ 1 (պարզ)՝ մեկ թոքեն բոլոր կատեգորիաներով
WB_SELLER_TOKEN=

# Տարբերակ 2 (WB-ի խորհուրդը՝ 1-3 կատեգորիա մեկ թոքենում)
# Կոդը ինքը կարդում է ամեն թոքենի bitmask-ը և ուղարկում հարցումը ճիշտ թոքենով։
# Ստուգել՝ python3 -m src.wb_seller decode
#WB_TOKEN_TARIFFS=   # Контент + Поставки (+Тарифы՝ ցանկացած թոքենով)
#WB_TOKEN_SALES=     # Статистика + Аналитика + Вопросы и отзывы

# ── Saleflow Analytics (saleflow.pro) ────────────────────────────────────────
# Endpoint՝ https://saleflow.pro/api/mcp  (MCP over HTTP, JSON-RPC 2.0)
# Auth՝     Authorization: Bearer <token>   ← ՄԻԱՅՆ այս ձևը ճանաչվում է
# Ստուգել՝  python3 -m src.saleflow probe
SALEFLOW_TOKEN=

# ── MPStats ──────────────────────────────────────────────────────────────────
MPSTATS_TOKEN=
